{
  "name": "drupalkit",
  "version": "0.0.0",
  "author": "Christian Foidl <christian@wunderwerk.io> (https://www.wunderwerk.io)",
  "keywords": [
    "api",
    "drupal",
    "drupalkit"
  ],
  "private": true,
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@changesets/git": "^3.0.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@drupal-kit/config-prettier": "workspace:*",
    "@manypkg/get-packages": "^2.2.1",
    "syncpack": "^15.3.1",
    "turbo": "^2.9.14"
  },
  "scripts": {
    "audit": "pnpm audit",
    "build": "turbo run build",
    "check-all": "turbo run build lint test typecheck",
    "format:check": "prettier --check 'packages/*/**/*.{ts,tsx}'",
    "format:write": "prettier --write 'packages/*/**/*.{ts,tsx}' && syncpack format",
    "lint": "turbo run lint",
    "publish-packages": "turbo run test && turbo run export-version && turbo run build lint typecheck && changeset publish --no-git-tag && node scripts/tag.mjs",
    "syncpack": "syncpack lint --dependency-types dev,overrides,peer,pnpmOverrides,prod,resolutions",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "typecheck": "turbo run typecheck",
    "version-packages": "turbo run build && turbo run lint && turbo run typecheck && turbo run test && changeset version && pnpm install --lockfile-only"
  },
  "packageManager": "pnpm@8.5.1",
  "pnpm": {
    "overrides": {
      "@babel/helpers": "7.28.6",
      "@babel/runtime": "7.28.6",
      "ajv@6": "6.14.0",
      "ajv@8": "8.20.0",
      "brace-expansion@1": "1.1.15",
      "brace-expansion@2": "2.0.2",
      "braces": "3.0.3",
      "cookie": "0.7.2",
      "cross-spawn": "7.0.6",
      "diff": "4.0.4",
      "effect": "3.20.0",
      "eslint>ajv": "6.14.0",
      "eslint>minimatch": "3.1.5",
      "flatted": "3.4.2",
      "js-yaml@3": "3.14.2",
      "js-yaml@4": "4.1.1",
      "lodash": "4.18.1",
      "micromatch": "4.0.8",
      "minimatch@3": "3.1.5",
      "minimatch@9": "9.0.7",
      "path-to-regexp": "6.3.0",
      "picomatch@2": "2.3.2",
      "picomatch@3": "3.0.2",
      "tar": "7.5.15",
      "tmp": "0.2.5"
    },
    "patchedDependencies": {
      "is-plain-object@5.0.0": "patches/is-plain-object@5.0.0.patch"
    }
  },
  "volta": {
    "node": "20.19.6"
  }
}
